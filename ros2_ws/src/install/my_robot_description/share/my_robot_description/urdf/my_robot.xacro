<?xml version="1.0"?>
<robot name="simple_example_robot">
<!-- Create a material -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
<!-- Create an object -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <!-- Apply material -->
      <material name="blue"/>
    </visual>
  </link>

  <link name="head_link">
    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.1"/>
      </geometry>
      <!-- Pos to be on the top of the box -->
      <origin xyz="0 0 0.15" rpy="0 0 0"/> 
      <material name="white"/>
    </visual>
  </link>

<!-- Link both object -->
  <joint name="neck_joint" type="continuous">
    <parent link="base_link"/>
    <child link="head_link"/>
    
    <!-- Pos of the car, xyz than rotation -->
    <origin xyz="0 0 0.1" rpy="0 0 0"/> 
    
    <axis xyz="0 0 1"/>
  </joint>

</robot>